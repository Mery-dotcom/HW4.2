<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginTop="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="20dp"
    android:backgroundTint="#908B8B"
    android:layout_width="match_parent"
    android:layout_height="220dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/today"
            android:text="Today"
            android:textStyle="bold"
            android:textSize="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/date"
            android:textStyle="bold"
            android:textSize="20dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="50dp"
            android:layout_height="22dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/rv_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="38dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:id="@+id/today_forecast"
            android:layout_width="70dp"
            android:layout_height="150dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/time_degree"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/time"
                android:layout_width="46dp"
                android:layout_height="22dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/today_forecast1"
            android:layout_width="70dp"
            android:layout_height="150dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/time_degree1"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/weather_icon1"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/time1"
                android:layout_width="46dp"
                android:layout_height="22dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/today_forecast2"
            android:layout_width="70dp"
            android:layout_height="150dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/time_degree2"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/weather_icon2"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/time2"
                android:layout_width="46dp"
                android:layout_height="22dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/today_forecast3"
            android:layout_width="70dp"
            android:layout_height="150dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/time_degree3"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/weather_icon3"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/time3"
                android:layout_width="46dp"
                android:layout_height="22dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
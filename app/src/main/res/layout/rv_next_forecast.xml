<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginTop="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="20dp"
    android:layout_width="match_parent"
    android:layout_height="150dp">

    <LinearLayout
        android:id="@+id/rv_next_forecast"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_next_forecast"
            android:text="Next Forecast"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/iv_next_forecast"
            android:layout_marginHorizontal="180dp"
            android:src="@drawable/iv_next_forecast"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weeks_set"
        android:layout_marginTop="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/week"
            android:layout_marginTop="6dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="20dp"
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <TextView
                android:id="@+id/txt_week"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="64dp"
                android:layout_height="24dp"/>

            <ImageView
                android:id="@+id/iv_week"
                android:layout_marginStart="40dp"
                android:layout_width="50dp"
                android:layout_height="50dp"/>

            <TextView
                android:id="@+id/txt_next_degree_day"
                android:textSize="18sp"
                android:layout_marginStart="30dp"
                android:textColor="@color/white"
                android:layout_width="26dp"
                android:layout_height="26dp"/>

            <TextView
                android:id="@+id/txt_next_degree_night"
                android:textSize="18sp"
                android:layout_marginStart="10dp"
                android:textColor="@color/white"
                android:layout_width="26dp"
                android:layout_height="26dp"/>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>